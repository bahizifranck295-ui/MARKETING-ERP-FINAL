# Interface marketing (identique à marketing-erp-final.vercel.app) : build de l'aperçu, servi en statique
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps --no-audit --no-fund
COPY . .
RUN npx vite build --config apercu/vite.config.ts

FROM nginx:alpine
COPY --from=build /app/apercu/dist /usr/share/nginx/html
RUN printf 'server {\n  listen 3000;\n  root /usr/share/nginx/html;\n  location / { try_files $uri $uri/ /index.html; }\n  location = /index.html { add_header Cache-Control "no-cache"; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 3000
